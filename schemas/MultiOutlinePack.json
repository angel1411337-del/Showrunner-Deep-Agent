{
  "$defs": {
    "InflectionOption": {
      "description": "One possible direction at an inflection point.",
      "properties": {
        "option_id": {
          "description": "Unique option identifier",
          "title": "Option Id",
          "type": "string"
        },
        "title": {
          "description": "Short option title",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "description": "What this option changes",
          "title": "Description",
          "type": "string"
        },
        "payoff_ids": {
          "description": "Payoffs enabled or affected by this option",
          "items": {
            "type": "string"
          },
          "title": "Payoff Ids",
          "type": "array"
        },
        "evidence_anchor_ids": {
          "description": "Evidence anchors supporting this option",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Anchor Ids",
          "type": "array"
        },
        "risk_notes": {
          "description": "Continuity or thematic risks",
          "items": {
            "type": "string"
          },
          "title": "Risk Notes",
          "type": "array"
        },
        "confidence": {
          "description": "Confidence score",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "option_id",
        "title",
        "description",
        "evidence_anchor_ids",
        "confidence"
      ],
      "title": "InflectionOption",
      "type": "object"
    },
    "InflectionPoint": {
      "description": "A decision node where the story can fork without breaking canon.",
      "properties": {
        "inflection_id": {
          "description": "Unique inflection identifier",
          "title": "Inflection Id",
          "type": "string"
        },
        "title": {
          "description": "Short label for the decision node",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "description": "Why this is a branch point",
          "title": "Description",
          "type": "string"
        },
        "evidence_anchor_ids": {
          "description": "Evidence anchors supporting the inflection",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Anchor Ids",
          "type": "array"
        },
        "story_time": {
          "$ref": "#/$defs/StoryTime",
          "description": "In-world time for the inflection"
        },
        "story_order": {
          "$ref": "#/$defs/StoryOrder",
          "description": "Narrative order for the inflection"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/InflectionOption"
          },
          "minItems": 1,
          "title": "Options",
          "type": "array"
        },
        "created_at": {
          "description": "Real-world creation timestamp",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "inflection_id",
        "title",
        "description",
        "evidence_anchor_ids",
        "story_time",
        "story_order",
        "options",
        "created_at"
      ],
      "title": "InflectionPoint",
      "type": "object"
    },
    "OutlineBeat": {
      "description": "A beat in an outline variant.",
      "properties": {
        "beat_id": {
          "description": "Unique beat identifier",
          "title": "Beat Id",
          "type": "string"
        },
        "title": {
          "description": "Short beat title",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "description": "Beat description",
          "title": "Description",
          "type": "string"
        },
        "obligation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Obligation Ids",
          "type": "array"
        },
        "payoff_ids": {
          "items": {
            "type": "string"
          },
          "title": "Payoff Ids",
          "type": "array"
        },
        "evidence_anchor_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Anchor Ids",
          "type": "array"
        },
        "story_time": {
          "$ref": "#/$defs/StoryTime",
          "description": "In-world time for beat"
        },
        "story_order": {
          "$ref": "#/$defs/StoryOrder",
          "description": "Narrative order for beat"
        }
      },
      "required": [
        "beat_id",
        "title",
        "description",
        "evidence_anchor_ids",
        "story_time",
        "story_order"
      ],
      "title": "OutlineBeat",
      "type": "object"
    },
    "OutlineVariant": {
      "description": "A full outline option constrained by canon and evidence.",
      "properties": {
        "outline_id": {
          "description": "Unique outline identifier",
          "title": "Outline Id",
          "type": "string"
        },
        "title": {
          "description": "Short outline title",
          "title": "Title",
          "type": "string"
        },
        "strategy": {
          "description": "Tone of the outline approach",
          "enum": [
            "conservative",
            "balanced",
            "high_risk"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "summary": {
          "description": "High-level outline summary",
          "title": "Summary",
          "type": "string"
        },
        "beats": {
          "items": {
            "$ref": "#/$defs/OutlineBeat"
          },
          "minItems": 1,
          "title": "Beats",
          "type": "array"
        },
        "payoff_ids": {
          "items": {
            "type": "string"
          },
          "title": "Payoff Ids",
          "type": "array"
        },
        "inflection_ids": {
          "items": {
            "type": "string"
          },
          "title": "Inflection Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "created_at": {
          "description": "Real-world creation timestamp",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "outline_id",
        "title",
        "strategy",
        "summary",
        "beats",
        "confidence",
        "created_at"
      ],
      "title": "OutlineVariant",
      "type": "object"
    },
    "Payoff": {
      "description": "A proposed resolution path for an unresolved thread.",
      "properties": {
        "payoff_id": {
          "description": "Unique payoff identifier",
          "title": "Payoff Id",
          "type": "string"
        },
        "obligation_id": {
          "description": "Obligation this payoff resolves",
          "title": "Obligation Id",
          "type": "string"
        },
        "title": {
          "description": "Short payoff label",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "description": "Payoff description",
          "title": "Description",
          "type": "string"
        },
        "evidence_anchor_ids": {
          "description": "Evidence anchors supporting this payoff path",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Anchor Ids",
          "type": "array"
        },
        "story_time": {
          "$ref": "#/$defs/StoryTime",
          "description": "In-world time for payoff"
        },
        "story_order": {
          "$ref": "#/$defs/StoryOrder",
          "description": "Narrative order for payoff"
        },
        "confidence": {
          "description": "Confidence score",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "created_at": {
          "description": "Real-world creation timestamp",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "payoff_id",
        "obligation_id",
        "title",
        "description",
        "evidence_anchor_ids",
        "story_time",
        "story_order",
        "confidence",
        "created_at"
      ],
      "title": "Payoff",
      "type": "object"
    },
    "StoryOrder": {
      "description": "Narrative order metadata for an element.",
      "properties": {
        "order_index": {
          "description": "Zero-based ordering within the narrative timeline",
          "minimum": 0,
          "title": "Order Index",
          "type": "integer"
        },
        "order_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional narrative label (e.g., 'book2:3', 'chapter 12')",
          "title": "Order Label"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional source document ID for the narrative order",
          "title": "Source Id"
        },
        "passage_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional passage ID for the narrative order",
          "title": "Passage Id"
        }
      },
      "required": [
        "order_index"
      ],
      "title": "StoryOrder",
      "type": "object"
    },
    "StoryTime": {
      "description": "In-world time metadata for an element.",
      "properties": {
        "time_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable in-world time label (e.g., '298 AC, late summer')",
          "title": "Time Label"
        },
        "time_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional in-world start time (ISO-like string or canon label)",
          "title": "Time Start"
        },
        "time_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional in-world end time (ISO-like string or canon label)",
          "title": "Time End"
        }
      },
      "title": "StoryTime",
      "type": "object"
    }
  },
  "description": "Container for multiple outline variants plus payoffs and inflections.",
  "properties": {
    "pack_id": {
      "description": "Unique pack identifier",
      "title": "Pack Id",
      "type": "string"
    },
    "corpus_label": {
      "description": "Corpus label or run identifier",
      "title": "Corpus Label",
      "type": "string"
    },
    "outlines": {
      "items": {
        "$ref": "#/$defs/OutlineVariant"
      },
      "minItems": 1,
      "title": "Outlines",
      "type": "array"
    },
    "payoffs": {
      "items": {
        "$ref": "#/$defs/Payoff"
      },
      "title": "Payoffs",
      "type": "array"
    },
    "inflections": {
      "items": {
        "$ref": "#/$defs/InflectionPoint"
      },
      "title": "Inflections",
      "type": "array"
    },
    "created_at": {
      "description": "Real-world creation timestamp",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "pack_id",
    "corpus_label",
    "outlines",
    "created_at"
  ],
  "title": "MultiOutlinePack",
  "type": "object"
}