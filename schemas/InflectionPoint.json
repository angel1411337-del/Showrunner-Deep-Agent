{
  "$defs": {
    "InflectionOption": {
      "description": "One possible direction at an inflection point.",
      "properties": {
        "option_id": {
          "description": "Unique option identifier",
          "title": "Option Id",
          "type": "string"
        },
        "title": {
          "description": "Short option title",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "description": "What this option changes",
          "title": "Description",
          "type": "string"
        },
        "payoff_ids": {
          "description": "Payoffs enabled or affected by this option",
          "items": {
            "type": "string"
          },
          "title": "Payoff Ids",
          "type": "array"
        },
        "evidence_anchor_ids": {
          "description": "Evidence anchors supporting this option",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Anchor Ids",
          "type": "array"
        },
        "risk_notes": {
          "description": "Continuity or thematic risks",
          "items": {
            "type": "string"
          },
          "title": "Risk Notes",
          "type": "array"
        },
        "confidence": {
          "description": "Confidence score",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "option_id",
        "title",
        "description",
        "evidence_anchor_ids",
        "confidence"
      ],
      "title": "InflectionOption",
      "type": "object"
    },
    "StoryOrder": {
      "description": "Narrative order metadata for an element.",
      "properties": {
        "order_index": {
          "description": "Zero-based ordering within the narrative timeline",
          "minimum": 0,
          "title": "Order Index",
          "type": "integer"
        },
        "order_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional narrative label (e.g., 'book2:3', 'chapter 12')",
          "title": "Order Label"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional source document ID for the narrative order",
          "title": "Source Id"
        },
        "passage_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional passage ID for the narrative order",
          "title": "Passage Id"
        }
      },
      "required": [
        "order_index"
      ],
      "title": "StoryOrder",
      "type": "object"
    },
    "StoryTime": {
      "description": "In-world time metadata for an element.",
      "properties": {
        "time_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable in-world time label (e.g., '298 AC, late summer')",
          "title": "Time Label"
        },
        "time_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional in-world start time (ISO-like string or canon label)",
          "title": "Time Start"
        },
        "time_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional in-world end time (ISO-like string or canon label)",
          "title": "Time End"
        }
      },
      "title": "StoryTime",
      "type": "object"
    }
  },
  "description": "A decision node where the story can fork without breaking canon.",
  "properties": {
    "inflection_id": {
      "description": "Unique inflection identifier",
      "title": "Inflection Id",
      "type": "string"
    },
    "title": {
      "description": "Short label for the decision node",
      "title": "Title",
      "type": "string"
    },
    "description": {
      "description": "Why this is a branch point",
      "title": "Description",
      "type": "string"
    },
    "evidence_anchor_ids": {
      "description": "Evidence anchors supporting the inflection",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Anchor Ids",
      "type": "array"
    },
    "story_time": {
      "$ref": "#/$defs/StoryTime",
      "description": "In-world time for the inflection"
    },
    "story_order": {
      "$ref": "#/$defs/StoryOrder",
      "description": "Narrative order for the inflection"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/InflectionOption"
      },
      "minItems": 1,
      "title": "Options",
      "type": "array"
    },
    "created_at": {
      "description": "Real-world creation timestamp",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "inflection_id",
    "title",
    "description",
    "evidence_anchor_ids",
    "story_time",
    "story_order",
    "options",
    "created_at"
  ],
  "title": "InflectionPoint",
  "type": "object"
}