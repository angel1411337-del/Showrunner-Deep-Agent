{
  "$defs": {
    "StoryOrder": {
      "description": "Narrative order metadata for an element.",
      "properties": {
        "order_index": {
          "description": "Zero-based ordering within the narrative timeline",
          "minimum": 0,
          "title": "Order Index",
          "type": "integer"
        },
        "order_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional narrative label (e.g., 'book2:3', 'chapter 12')",
          "title": "Order Label"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional source document ID for the narrative order",
          "title": "Source Id"
        },
        "passage_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional passage ID for the narrative order",
          "title": "Passage Id"
        }
      },
      "required": [
        "order_index"
      ],
      "title": "StoryOrder",
      "type": "object"
    },
    "StoryTime": {
      "description": "In-world time metadata for an element.",
      "properties": {
        "time_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable in-world time label (e.g., '298 AC, late summer')",
          "title": "Time Label"
        },
        "time_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional in-world start time (ISO-like string or canon label)",
          "title": "Time Start"
        },
        "time_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional in-world end time (ISO-like string or canon label)",
          "title": "Time End"
        }
      },
      "title": "StoryTime",
      "type": "object"
    }
  },
  "description": "A proposed resolution path for an unresolved thread.",
  "properties": {
    "payoff_id": {
      "description": "Unique payoff identifier",
      "title": "Payoff Id",
      "type": "string"
    },
    "obligation_id": {
      "description": "Obligation this payoff resolves",
      "title": "Obligation Id",
      "type": "string"
    },
    "title": {
      "description": "Short payoff label",
      "title": "Title",
      "type": "string"
    },
    "description": {
      "description": "Payoff description",
      "title": "Description",
      "type": "string"
    },
    "evidence_anchor_ids": {
      "description": "Evidence anchors supporting this payoff path",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Anchor Ids",
      "type": "array"
    },
    "story_time": {
      "$ref": "#/$defs/StoryTime",
      "description": "In-world time for payoff"
    },
    "story_order": {
      "$ref": "#/$defs/StoryOrder",
      "description": "Narrative order for payoff"
    },
    "confidence": {
      "description": "Confidence score",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "created_at": {
      "description": "Real-world creation timestamp",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "payoff_id",
    "obligation_id",
    "title",
    "description",
    "evidence_anchor_ids",
    "story_time",
    "story_order",
    "confidence",
    "created_at"
  ],
  "title": "Payoff",
  "type": "object"
}