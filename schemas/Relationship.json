{
  "$defs": {
    "RelationshipType": {
      "description": "Relationship classification between entities.",
      "enum": [
        "alliance",
        "enmity",
        "kinship",
        "oath",
        "debt",
        "command",
        "membership",
        "ownership",
        "other"
      ],
      "title": "RelationshipType",
      "type": "string"
    },
    "StoryOrder": {
      "description": "Narrative order metadata for an element.",
      "properties": {
        "order_index": {
          "description": "Zero-based ordering within the narrative timeline",
          "minimum": 0,
          "title": "Order Index",
          "type": "integer"
        },
        "order_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional narrative label (e.g., 'book2:3', 'chapter 12')",
          "title": "Order Label"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional source document ID for the narrative order",
          "title": "Source Id"
        },
        "passage_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional passage ID for the narrative order",
          "title": "Passage Id"
        }
      },
      "required": [
        "order_index"
      ],
      "title": "StoryOrder",
      "type": "object"
    },
    "StoryTime": {
      "description": "In-world time metadata for an element.",
      "properties": {
        "time_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable in-world time label (e.g., '298 AC, late summer')",
          "title": "Time Label"
        },
        "time_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional in-world start time (ISO-like string or canon label)",
          "title": "Time Start"
        },
        "time_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional in-world end time (ISO-like string or canon label)",
          "title": "Time End"
        }
      },
      "title": "StoryTime",
      "type": "object"
    }
  },
  "description": "Relationship between two entities with provenance and temporal metadata.",
  "properties": {
    "relationship_id": {
      "description": "Unique identifier for this relationship",
      "title": "Relationship Id",
      "type": "string"
    },
    "relation_type": {
      "$ref": "#/$defs/RelationshipType",
      "description": "Relationship category"
    },
    "source_entity_id": {
      "description": "Source entity ID",
      "title": "Source Entity Id",
      "type": "string"
    },
    "target_entity_id": {
      "description": "Target entity ID",
      "title": "Target Entity Id",
      "type": "string"
    },
    "description": {
      "description": "Summary of the relationship",
      "title": "Description",
      "type": "string"
    },
    "evidence_anchor_ids": {
      "description": "Evidence anchor IDs supporting this relationship",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Anchor Ids",
      "type": "array"
    },
    "story_time": {
      "$ref": "#/$defs/StoryTime",
      "description": "In-world time metadata"
    },
    "story_order": {
      "$ref": "#/$defs/StoryOrder",
      "description": "Narrative order metadata"
    },
    "created_at": {
      "description": "Real-world creation timestamp",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "relationship_id",
    "relation_type",
    "source_entity_id",
    "target_entity_id",
    "description",
    "evidence_anchor_ids",
    "story_time",
    "story_order",
    "created_at"
  ],
  "title": "Relationship",
  "type": "object"
}