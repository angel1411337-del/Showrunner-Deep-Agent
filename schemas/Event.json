{
  "$defs": {
    "EventType": {
      "description": "Event classification for wiki entries.",
      "enum": [
        "battle",
        "death",
        "treaty",
        "betrayal",
        "marriage",
        "coronation",
        "travel",
        "discovery",
        "other"
      ],
      "title": "EventType",
      "type": "string"
    },
    "StoryOrder": {
      "description": "Narrative order metadata for an element.",
      "properties": {
        "order_index": {
          "description": "Zero-based ordering within the narrative timeline",
          "minimum": 0,
          "title": "Order Index",
          "type": "integer"
        },
        "order_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional narrative label (e.g., 'book2:3', 'chapter 12')",
          "title": "Order Label"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional source document ID for the narrative order",
          "title": "Source Id"
        },
        "passage_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional passage ID for the narrative order",
          "title": "Passage Id"
        }
      },
      "required": [
        "order_index"
      ],
      "title": "StoryOrder",
      "type": "object"
    },
    "StoryTime": {
      "description": "In-world time metadata for an element.",
      "properties": {
        "time_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable in-world time label (e.g., '298 AC, late summer')",
          "title": "Time Label"
        },
        "time_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional in-world start time (ISO-like string or canon label)",
          "title": "Time Start"
        },
        "time_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional in-world end time (ISO-like string or canon label)",
          "title": "Time End"
        }
      },
      "title": "StoryTime",
      "type": "object"
    }
  },
  "description": "Canonical event suitable for a narrative wiki.",
  "properties": {
    "event_id": {
      "description": "Unique identifier for this event",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType",
      "description": "Event category"
    },
    "title": {
      "description": "Short event title",
      "title": "Title",
      "type": "string"
    },
    "description": {
      "description": "Event summary",
      "title": "Description",
      "type": "string"
    },
    "participant_entity_ids": {
      "description": "Entity IDs participating in the event",
      "items": {
        "type": "string"
      },
      "title": "Participant Entity Ids",
      "type": "array"
    },
    "location_entity_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Primary location entity ID for the event",
      "title": "Location Entity Id"
    },
    "related_obligation_ids": {
      "description": "Related obligation IDs (if event resolves or triggers obligations)",
      "items": {
        "type": "string"
      },
      "title": "Related Obligation Ids",
      "type": "array"
    },
    "evidence_anchor_ids": {
      "description": "Evidence anchor IDs supporting this event",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Anchor Ids",
      "type": "array"
    },
    "story_time": {
      "$ref": "#/$defs/StoryTime",
      "description": "In-world time metadata"
    },
    "story_order": {
      "$ref": "#/$defs/StoryOrder",
      "description": "Narrative order metadata"
    },
    "created_at": {
      "description": "Real-world creation timestamp",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "title",
    "description",
    "evidence_anchor_ids",
    "story_time",
    "story_order",
    "created_at"
  ],
  "title": "Event",
  "type": "object"
}